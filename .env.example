DOGOBLOCK_API_HOST=https://dogoblockapi.dogomaker.com
DOGOBLOCK_ASSET_HOST=https://dogoblockcdn.dogomaker.com
GA_ID=G-XXXXXXXXXX
GA_DEBUG=false
GA_TEST_MODE=false

# Public Sentry client configuration. Leave SENTRY_DSN empty to hide feedback.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TUNNEL_URL=https://dogoblockapi.dogomaker.com/observability/envelope

# Build-only values used to upload source maps. Never expose the auth token in client code.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
