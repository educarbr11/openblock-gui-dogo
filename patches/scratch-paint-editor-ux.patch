+++ b/src/components/paint-editor/properties-panel.css
@@ -0,0 +1,113 @@
+@import "../../css/colors.css";
+@import "../../css/units.css";
+
+.panel {
+    flex: 0 0 232px;
+    min-width: 0;
+    border-left: 1px solid $ui-pane-border;
+    background: #fff;
+    overflow: auto;
+}
+
+.panel.closed {
+    flex-basis: 36px;
+    overflow: hidden;
+}
+
+.toggle {
+    width: 100%;
+    min-height: 36px;
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    border: 0;
+    border-bottom: 1px solid $ui-pane-border;
+    background: $ui-pane-gray;
+    color: $text-primary;
+    font-weight: bold;
+    cursor: pointer;
+    padding: 0 12px;
+}
+
+.closed .toggle {
+    width: 36px;
+    padding: 0 10px;
+}
+
+.closed .toggle span:first-child {
+    display: none;
+}
+
+.content {
+    padding: 8px 12px 16px;
+}
+
+.section {
+    padding: 9px 0;
+    border-bottom: 1px solid $ui-pane-border;
+}
+
+.section h3 {
+    margin: 0 0 10px;
+    font-size: 0.82rem;
+    color: $text-primary;
+}
+
+.field-grid {
+    display: grid;
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: 8px;
+}
+
+.field {
+    min-width: 0;
+    display: flex;
+    align-items: center;
+    gap: 5px;
+    color: $text-primary;
+    font-size: 0.75rem;
+}
+
+.field span {
+    flex: 0 0 25px;
+}
+
+.field input {
+    width: 100%;
+    min-width: 0;
+    height: 30px;
+    border: 1px solid $ui-pane-border;
+    border-radius: 4px;
+    padding: 0 5px;
+    font-size: 0.75rem;
+    color: $text-primary;
+}
+
+.color-row {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 8px;
+}
+
+.hint {
+    color: $text-primary;
+    font-size: 0.75rem;
+}
+
+@media (max-width: 1599px) {
+    .panel.open {
+        position: absolute;
+        top: 0;
+        right: 0;
+        bottom: 0;
+        z-index: 6;
+        width: 232px;
+        box-shadow: -3px 0 12px rgba(0, 0, 0, 0.18);
+    }
+}
+
+@media (max-width: 960px) {
+    .panel {
+        display: none;
+    }
+}
