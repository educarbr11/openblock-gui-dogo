+import paper from '@scratch/paper';
+import PropTypes from 'prop-types';
+import React from 'react';
+import {connect} from 'react-redux';
+import {defineMessages, injectIntl, intlShape} from 'react-intl';
+import getFonts from 'scratch-render-fonts';
+
+import Dropdown from '../components/dropdown/dropdown.jsx';
+import Fonts from '../lib/fonts';
+import {changeFont} from '../reducers/font';
+import styles from '../components/font-dropdown/searchable-font-dropdown.css';
+
+const messages = defineMessages({
+    search: {id: 'paint.fontPicker.search', defaultMessage: 'Search fonts'},
+    empty: {id: 'paint.fontPicker.empty', defaultMessage: 'No matching fonts'},
+    loadError: {id: 'paint.fontPicker.loadError', defaultMessage: 'Could not load this font'}
+});
+const FONT_NAMES = Object.keys(Fonts).map(key => Fonts[key]);
+
+class SearchableFontDropdown extends React.Component {
+    constructor (props) {
+        super(props);
+        this.state = {query: '', loadError: false};
+        this.handleChoose = this.handleChoose.bind(this);
+    }
+    handleChoose (font) {
+        const project = paper.project;
+        const selectedText = this.props.selectedItems.filter(item => item instanceof paper.PointText);
+        const load = document.fonts && document.fonts.load ? document.fonts.load(`40px "${font}"`) : Promise.resolve();
+        Promise.resolve(load).then(() => {
+            if (project !== paper.project) return;
+            selectedText.forEach(item => {
+                if (item.project === project) item.font = font;
+            });
+            this.props.onChangeFont(font);
+            if (selectedText.length) this.props.onUpdateImage();
+            this.setState({query: '', loadError: false});
+            if (this.dropdown) this.dropdown.handleClosePopover();
+        }).catch(() => this.setState({loadError: true}));
+    }
+    render () {
+        const query = this.state.query.toLocaleLowerCase();
+        const fonts = FONT_NAMES.filter(font => font.toLocaleLowerCase().includes(query));
+        return (
+            <Dropdown
+                className={styles.trigger}
+                popoverContent={
+                    <div className={styles.menu}>
+                        <input
+                            aria-label={this.props.intl.formatMessage(messages.search)}
+                            autoFocus
+                            placeholder={this.props.intl.formatMessage(messages.search)}
+                            type="search"
+                            value={this.state.query}
+                            onChange={event => this.setState({query: event.target.value})}
+                        />
+                        <div className={styles.list}>
+                            {fonts.map(font => (
+                                <button
+                                    className={font === this.props.font ? styles.selected : ''}
+                                    key={font}
+                                    style={{fontFamily: `"${font}"`}}
+                                    title={font}
+                                    onClick={() => this.handleChoose(font)}
+                                >
+                                    {font}
+                                </button>
+                            ))}
+                            {!fonts.length ? <p>{this.props.intl.formatMessage(messages.empty)}</p> : null}
+                        </div>
+                        {this.state.loadError ? <p>{this.props.intl.formatMessage(messages.loadError)}</p> : null}
+                    </div>
+                }
+                ref={element => { this.dropdown = element; }}
+                onOpen={() => {
+                    getFonts();
+                    this.setState({query: '', loadError: false});
+                }}
+            >
+                <span style={{fontFamily: `"${this.props.font}"`}}>{this.props.font}</span>
+            </Dropdown>
+        );
+    }
+}
+
+SearchableFontDropdown.propTypes = {
+    font: PropTypes.string,
+    intl: intlShape.isRequired,
+    onChangeFont: PropTypes.func.isRequired,
+    onUpdateImage: PropTypes.func.isRequired,
+    selectedItems: PropTypes.arrayOf(PropTypes.instanceOf(paper.Item)).isRequired
+};
+
+const mapStateToProps = state => ({
+    font: state.scratchPaint.font,
+    selectedItems: state.scratchPaint.selectedItems
+});
+const mapDispatchToProps = dispatch => ({
+    onChangeFont: font => dispatch(changeFont(font))
+});
+
+export default connect(mapStateToProps, mapDispatchToProps)(injectIntl(SearchableFontDropdown));
