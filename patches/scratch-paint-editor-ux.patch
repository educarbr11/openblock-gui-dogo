@@ -0,0 +1,163 @@
+import paper from '@scratch/paper';
+import PropTypes from 'prop-types';
+import React from 'react';
+import {connect} from 'react-redux';
+import {defineMessages, injectIntl, intlShape} from 'react-intl';
+
+import FillColorIndicator from './fill-color-indicator.jsx';
+import StrokeColorIndicator from './stroke-color-indicator.jsx';
+import StrokeWidthIndicator from './stroke-width-indicator.jsx';
+import ModeTools from './mode-tools.jsx';
+import FontDropdown from './searchable-font-dropdown.jsx';
+import {redrawSelectionBox} from '../reducers/selected-items';
+import Formats, {isVector} from '../lib/format';
+import Modes from '../lib/modes';
+import styles from '../components/paint-editor/properties-panel.css';
+
+const messages = defineMessages({
+    title: {id: 'paint.properties.title', defaultMessage: 'Properties'},
+    show: {id: 'paint.properties.show', defaultMessage: 'Show properties'},
+    hide: {id: 'paint.properties.hide', defaultMessage: 'Hide properties'},
+    appearance: {id: 'paint.properties.appearance', defaultMessage: 'Appearance'},
+    transform: {id: 'paint.properties.transform', defaultMessage: 'Transform'},
+    text: {id: 'paint.properties.text', defaultMessage: 'Text'},
+    x: {id: 'paint.properties.x', defaultMessage: 'X'},
+    y: {id: 'paint.properties.y', defaultMessage: 'Y'},
+    width: {id: 'paint.properties.width', defaultMessage: 'Width'},
+    height: {id: 'paint.properties.height', defaultMessage: 'Height'},
+    rotation: {id: 'paint.properties.rotation', defaultMessage: 'Rotation'},
+    fontSize: {id: 'paint.properties.fontSize', defaultMessage: 'Size'},
+    multiple: {id: 'paint.properties.multiple', defaultMessage: 'Multiple objects selected'}
+});
+
+const formatValue = value => Number.isFinite(value) ? Math.round(value * 10) / 10 : 0;
+
+class PropertiesPanel extends React.Component {
+    constructor (props) {
+        super(props);
+        this.state = {open: window.innerWidth >= 1600};
+        this.handleToggle = this.handleToggle.bind(this);
+        this.handleGeometryChange = this.handleGeometryChange.bind(this);
+    }
+    handleToggle () {
+        this.setState({open: !this.state.open});
+    }
+    handleGeometryChange (property, inputValue) {
+        const item = this.props.selectedItems[0];
+        const value = Number(inputValue);
+        if (!item || !Number.isFinite(value) || Math.abs(value) > 10000) return;
+
+        const bounds = item.bounds;
+        if (property === 'x' || property === 'y') {
+            item.position = new paper.Point(
+                property === 'x' ? value : item.position.x,
+                property === 'y' ? value : item.position.y
+            );
+        } else if (property === 'width' && value > 0 && bounds.width > 0) {
+            item.scale(value / bounds.width, 1);
+        } else if (property === 'height' && value > 0 && bounds.height > 0) {
+            item.scale(1, value / bounds.height);
+        } else if (property === 'rotation') {
+            item.rotate(value - item.rotation);
+        } else if (property === 'fontSize' && item instanceof paper.PointText && value >= 1 && value <= 500) {
+            item.fontSize = value;
+        } else {
+            return;
+        }
+        this.props.onUpdateImage();
+        this.props.onRedrawSelectionBox();
+    }
+    renderField (name, value) {
+        return (
+            <label className={styles.field}>
+                <span>{this.props.intl.formatMessage(messages[name])}</span>
+                <input
+                    key={`${this.props.selectedItems[0].id}-${name}-${formatValue(value)}`}
+                    aria-label={this.props.intl.formatMessage(messages[name])}
+                    defaultValue={formatValue(value)}
+                    step="0.1"
+                    type="number"
+                    onBlur={event => this.handleGeometryChange(name, event.target.value)}
+                    onKeyDown={event => {
+                        if (event.key === 'Enter') event.currentTarget.blur();
+                    }}
+                />
+            </label>
+        );
+    }
+    render () {
+        const vector = isVector(this.props.format);
+        const item = vector && this.props.selectedItems.length === 1 ? this.props.selectedItems[0] : null;
+        const showTextFont = item instanceof paper.PointText && this.props.mode !== Modes.TEXT;
+        return (
+            <aside className={`${styles.panel} ${this.state.open ? styles.open : styles.closed}`}>
+                <button
+                    aria-expanded={this.state.open}
+                    aria-label={this.props.intl.formatMessage(this.state.open ? messages.hide : messages.show)}
+                    className={styles.toggle}
+                    title={this.props.intl.formatMessage(this.state.open ? messages.hide : messages.show)}
+                    onClick={this.handleToggle}
+                >
+                    <span>{this.props.intl.formatMessage(messages.title)}</span>
+                    <span aria-hidden="true">{this.state.open ? '\u203a' : '\u2039'}</span>
+                </button>
+                {this.state.open ? (
+                    <div className={styles.content}>
+                        {item ? (
+                            <section className={styles.section}>
+                                <h3>{this.props.intl.formatMessage(messages.transform)}</h3>
+                                <div className={styles.fieldGrid}>
+                                    {this.renderField('x', item.position.x)}
+                                    {this.renderField('y', item.position.y)}
+                                    {this.renderField('width', item.bounds.width)}
+                                    {this.renderField('height', item.bounds.height)}
+                                    {this.renderField('rotation', item.rotation)}
+                                </div>
+                            </section>
+                        ) : this.props.selectedItems.length > 1 ? (
+                            <p className={styles.hint}>{this.props.intl.formatMessage(messages.multiple)}</p>
+                        ) : null}
+                        {(item instanceof paper.PointText || this.props.mode === Modes.TEXT) && vector ? (
+                            <section className={styles.section}>
+                                <h3>{this.props.intl.formatMessage(messages.text)}</h3>
+                                {showTextFont ? <FontDropdown onUpdateImage={this.props.onUpdateImage} /> : null}
+                                {item instanceof paper.PointText ? this.renderField('fontSize', item.fontSize) : null}
+                            </section>
+                        ) : null}
+                        <section className={styles.section}>
+                            <h3>{this.props.intl.formatMessage(messages.appearance)}</h3>
+                            <div className={styles.colorRow}>
+                                <FillColorIndicator onUpdateImage={this.props.onUpdateImage} />
+                                {vector ? <StrokeColorIndicator onUpdateImage={this.props.onUpdateImage} /> : null}
+                            </div>
+                            {vector ? <StrokeWidthIndicator onUpdateImage={this.props.onUpdateImage} /> : null}
+                        </section>
+                        <section className={styles.section}>
+                            <ModeTools onUpdateImage={this.props.onUpdateImage} />
+                        </section>
+                    </div>
+                ) : null}
+            </aside>
+        );
+    }
+}
+
+PropertiesPanel.propTypes = {
+    format: PropTypes.oneOf(Object.keys(Formats)),
+    intl: intlShape.isRequired,
+    mode: PropTypes.oneOf(Object.keys(Modes)),
+    onRedrawSelectionBox: PropTypes.func.isRequired,
+    onUpdateImage: PropTypes.func.isRequired,
+    selectedItems: PropTypes.arrayOf(PropTypes.instanceOf(paper.Item)).isRequired
+};
+
+const mapStateToProps = state => ({
+    format: state.scratchPaint.format,
+    mode: state.scratchPaint.mode,
+    selectedItems: state.scratchPaint.selectedItems
+});
+const mapDispatchToProps = dispatch => ({
+    onRedrawSelectionBox: () => dispatch(redrawSelectionBox())
+});
+
+export default connect(mapStateToProps, mapDispatchToProps)(injectIntl(PropertiesPanel));
